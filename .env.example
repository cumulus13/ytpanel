# --- required ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-too
# --- web ---
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://panel.example.com
# Plain-HTTP testing only (otherwise cookies are Secure and login will not stick over http):
DJANGO_SECURE_COOKIES=0
# DJANGO_BEHIND_TLS_PROXY=1
# --- optional ---
# YTP_WORKER_CONCURRENCY=8
# YTP_HEARTBEAT_GRACE=60
# YTP_INNER_RETRIES=3
# YTP_LOG_LEVEL=INFO
